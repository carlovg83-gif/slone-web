<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 660 120" width="100%" height="100%">
  <defs>
    <!-- Gradiente Oro Nórdico -->
    <linearGradient id="lockupGold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF5C0" />
      <stop offset="45%" stop-color="#FFD700" />
      <stop offset="100%" stop-color="#B8860B" />
    </linearGradient>

    <!-- Gradiente Titanio Puro -->
    <linearGradient id="lockupTitanium" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="70%" stop-color="#E2E8F0" />
      <stop offset="100%" stop-color="#94A3B8" />
    </linearGradient>
  </defs>

  <!-- ISOTIPO SOBERANO (Escalado armónico a 84px de alto) -->
  <g transform="translate(15, 12) scale(0.24)">
    <!-- Anillo de Transmisión Continua -->
    <circle cx="250" cy="275" r="145" fill="none" stroke="url(#lockupGold)" stroke-width="26" stroke-linecap="round" />
    <!-- Polos de Sincronización Temporal (Vídeo + Audio 0 ms) -->
    <circle cx="195" cy="82" r="22" fill="url(#lockupGold)" />
    <circle cx="305" cy="82" r="22" fill="url(#lockupGold)" />
  </g>

  <!-- TIPOGRAFÍA INSTITUCIONAL: SLÖNE CÖRP (Pure Grotesk con Ö soberana en CÖRP) -->
  <g transform="translate(130, 68)">
    <text font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Inter', 'Helvetica Neue', Arial, sans-serif" 
          font-size="44" 
          font-weight="900" 
          letter-spacing="10" 
          fill="url(#lockupTitanium)">
      SLÖNE CÖRP
    </text>
  </g>

  <!-- DESCRIPTOR DE INGENIERÍA SOBERANA CON Ö SOBERANA -->
  <g transform="translate(134, 90)">
    <text font-family="-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', sans-serif" 
          font-size="9" 
          font-weight="800" 
          letter-spacing="5" 
          fill="url(#lockupGold)" 
          opacity="0.95">
      SÖVEREIGN MEDIA SUITE · 0 MS SYNC
    </text>
  </g>
</svg>
