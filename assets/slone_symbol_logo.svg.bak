<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <linearGradient id="symGoldPure" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFF5C0" />
      <stop offset="45%" stop-color="#FFD700" />
      <stop offset="100%" stop-color="#B8860B" />
    </linearGradient>
  </defs>

  <!-- Contenedor cuadrado redondeado oscuro con borde sutil -->
  <rect width="100" height="100" rx="24" fill="#07090E" />
  <rect width="98" height="98" x="1" y="1" rx="23" fill="none" stroke="rgba(255,215,0,0.15)" stroke-width="1.2" />

  <!-- Isotipo escalado central -->
  <g transform="translate(18, 16) scale(0.13)">
    <!-- Anillo Soberano -->
    <circle cx="250" cy="275" r="145" fill="none" stroke="url(#symGoldPure)" stroke-width="28" stroke-linecap="round" />
    <!-- Polos de Sincronización Temporal -->
    <circle cx="195" cy="82" r="26" fill="url(#symGoldPure)" />
    <circle cx="305" cy="82" r="26" fill="url(#symGoldPure)" />
  </g>
</svg>
